generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DB_URL")
}

model eca_companies {
  pk_id            Int         @id @default(autoincrement())
  company_document String      @unique(map: "cts_unique_companies_company_document") @db.VarChar(25)
  company_name     String      @db.VarChar(255)
  email            String      @unique(map: "cts_unique_companies_email") @db.VarChar(255)
  telephone        String?     @db.VarChar(15)
  creation_date    DateTime    @default(dbgenerated("CURRENT_DATE")) @db.Timestamp(6)
  change_date      DateTime?   @db.Timestamp(6)
  eca_users        eca_users[]
}

model eca_genders {
  pk_id         Int         @id @default(autoincrement())
  gender_name   String      @db.VarChar(255)
  creation_date DateTime    @default(dbgenerated("CURRENT_DATE")) @db.Timestamp(6)
  change_date   DateTime?   @db.Timestamp(6)
  eca_users     eca_users[]
}

model eca_stops {
  pk_id            Int       @id @default(autoincrement())
  address          String?   @db.VarChar(255)
  pfk_eca_users_id Int
  creation_date    DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Timestamp(6)
  change_date      DateTime? @db.Timestamp(6)
  eca_users        eca_users @relation(fields: [pfk_eca_users_id], references: [pk_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_eca_users_id")
}

model eca_users {
  pk_id                Int           @id @default(autoincrement())
  username             String        @db.VarChar(255)
  user_lastname        String        @db.VarChar(255)
  birth                DateTime      @db.Date
  pfk_eca_genders_id   Int
  email                String        @unique(map: "cts_unique_eca_users_email") @db.VarChar(255)
  user_password        String
  pfk_eca_companies_id Int
  cpf                  String        @unique(map: "cts_unique_eca_users_cpf") @db.VarChar(14)
  pix                  String?       @db.VarChar(255)
  telephone            String?       @db.VarChar(15)
  cnh                  String?       @unique(map: "cts_unique_eca_users_cnh") @db.VarChar(11)
  pfk_eca_vehicles_id  Int?
  profile_photo        Bytes
  creation_date        DateTime      @default(dbgenerated("CURRENT_DATE")) @db.Timestamp(6)
  change_date          DateTime?     @db.Timestamp(6)
  eca_stops            eca_stops[]
  eca_companies        eca_companies @relation(fields: [pfk_eca_companies_id], references: [pk_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_eca_companies_id")
  eca_genders          eca_genders   @relation(fields: [pfk_eca_genders_id], references: [pk_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_eca_genders_id")
  eca_vehicles         eca_vehicles? @relation(fields: [pfk_eca_vehicles_id], references: [pk_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_eca_vehicles_id")
}

model eca_vehicles {
  pk_id         Int         @id @default(autoincrement())
  brand         String      @db.VarChar(100)
  model         String      @db.VarChar(255)
  color         String      @db.VarChar(100)
  plate         String      @unique(map: "cts_eca_unique_vehicles_plate") @db.VarChar(10)
  passengers    Int
  creation_date DateTime    @default(dbgenerated("CURRENT_DATE")) @db.Timestamp(6)
  change_date   DateTime?   @db.Timestamp(6)
  eca_users     eca_users[]
}
